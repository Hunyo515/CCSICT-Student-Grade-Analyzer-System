# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Set false only for local HTTP development. Production requires HTTPS.
COOKIE_SECURE=true
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=cct_app
# Owner of the academic tables; runtime user should have only DML grants.
ORACLE_SCHEMA=student
ORACLE_PASSWORD=
# Optional absolute path; default is instance/security.sqlite3.
SECURITY_DB=

# Shared campus NAT needs a higher IP allowance; account limit remains 5/15min.
AUTH_IP_LIMIT=1200
AUTH_IP_WINDOW=900

# Gmail login-code delivery. Use a Google App Password, never your normal password.
# Enable 2-Step Verification on the sender's Google account before generating it.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SSL=false
